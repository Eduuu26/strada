# Strada — copia a .env

# Backend local (recomendado para desarrollo)
EXPO_PUBLIC_BACKEND_PROVIDER=strada-api
EXPO_PUBLIC_STRADA_API_URL=http://127.0.0.1:8788
EXPO_PUBLIC_STRADA_EMAIL_API=http://127.0.0.1:8788

# Supabase desactivado (migración a Strada API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# URLs legales (local)
EXPO_PUBLIC_PRIVACY_POLICY_URL=docs/privacy-policy.html
EXPO_PUBLIC_TERMS_URL=docs/terms-of-service.html
EXPO_PUBLIC_LEGAL_NOTICE_URL=docs/aviso-legal.html
EXPO_PUBLIC_COOKIE_POLICY_URL=docs/cookie-policy.html
EXPO_PUBLIC_SUBSCRIPTION_TERMS_URL=docs/subscription-terms.html

# Opcional — mapas
# EXPO_PUBLIC_MAPBOX_TOKEN=pk.eyJ...

# Producción — ver LAUNCH.md
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# EAS_PROJECT_ID=
