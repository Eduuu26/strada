{
  "name": "strada",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "node -e \"const fs=require('fs');const p='public/docs';fs.mkdirSync(p,{recursive:true});fs.readdirSync('docs').filter(f=>f.endsWith('.html')).forEach(f=>fs.copyFileSync('docs/'+f,p+'/'+f));\"",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "email-server": "npm --prefix server start",
    "email-server:install": "npm --prefix server install",
    "dev:api": "npm --prefix server start",
    "dev:web": "expo start --web --port 8084",
    "test:all": "npm run test:backend-contract && npm run test:social && npm run test:content-policy",
    "test:group-location": "node scripts/test-group-location.mjs",
    "test:car-match": "node scripts/test-car-match.mjs",
    "test:club-ranking": "node scripts/test-club-ranking.mjs",
    "test:social": "node scripts/test-social.mjs",
    "test:content-policy": "node scripts/test-content-policy.mjs",
    "test:backend-contract": "node scripts/test-backend-contract.mjs",
    "e2e:expo": "node scripts/e2e-expo-smoke.mjs",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "submit:ios": "eas submit --platform ios --latest",
    "submit:android": "eas submit --platform android --latest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/datetimepicker": "^8.2.0",
    "@supabase/supabase-js": "^2.49.8",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.0",
    "expo-device": "~7.0.0",
    "expo-image-picker": "~16.0.6",
    "expo-linking": "~7.0.0",
    "expo-location": "~18.0.0",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.0",
    "typescript": "~5.3.0"
  }
}
